{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "slug": "purple",
                    "color": "#262261",
                    "name": "Navy"
                },
                {
                    "slug": "pink",
                    "color": "#E8196D",
                    "name": "Magenta"
                },
                {
                    "slug": "dark",
                    "color": "#111111",
                    "name": "Ink"
                },
                {
                    "slug": "cyan",
                    "color": "#00ADEE",
                    "name": "Cyan"
                },
                {
                    "slug": "lavender",
                    "color": "#2B2E6F",
                    "name": "Azul"
                },
                {
                    "slug": "coral",
                    "color": "#FF0000",
                    "name": "Vermelho"
                },
                {
                    "slug": "yellow",
                    "color": "#FFF100",
                    "name": "Amarelo"
                },
                {
                    "slug": "lime",
                    "color": "#D6DE23",
                    "name": "Lima"
                },
                {
                    "slug": "green",
                    "color": "#009345",
                    "name": "Verde"
                },
                {
                    "slug": "light-gray",
                    "color": "#ededed",
                    "name": "Painel"
                },
                {
                    "slug": "paper",
                    "color": "#f1efe6",
                    "name": "Papel"
                },
                {
                    "slug": "white",
                    "color": "#ffffff",
                    "name": "White"
                }
            ],
            "gradients": [
                {
                    "slug": "purple-pink",
                    "gradient": "linear-gradient(135deg, #262261 0%, #E8196D 100%)",
                    "name": "Navy para Magenta"
                },
                {
                    "slug": "pink-purple",
                    "gradient": "linear-gradient(135deg, #E8196D 0%, #262261 100%)",
                    "name": "Magenta para Navy"
                },
                {
                    "slug": "purple-dark",
                    "gradient": "linear-gradient(180deg, #262261 0%, #111111 100%)",
                    "name": "Navy para Ink"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Jersey 10', 'Blinker', sans-serif",
                    "slug": "jersey-10",
                    "name": "Jersey 10"
                },
                {
                    "fontFamily": "'Blinker', sans-serif",
                    "slug": "blinker",
                    "name": "Blinker"
                },
                {
                    "fontFamily": "'Barlow', sans-serif",
                    "slug": "barlow",
                    "name": "Barlow"
                },
                {
                    "fontFamily": "'Barlow Semi Condensed', sans-serif",
                    "slug": "barlow-condensed",
                    "name": "Barlow Semi Condensed"
                },
                {
                    "fontFamily": "'Inter', sans-serif",
                    "slug": "inter",
                    "name": "Inter"
                },
                {
                    "fontFamily": "'Poppins', sans-serif",
                    "slug": "poppins",
                    "name": "Poppins"
                },
                {
                    "fontFamily": "'Montserrat', sans-serif",
                    "slug": "montserrat",
                    "name": "Montserrat"
                },
                {
                    "fontFamily": "'Roboto', sans-serif",
                    "slug": "roboto",
                    "name": "Roboto"
                },
                {
                    "fontFamily": "'Playfair Display', serif",
                    "slug": "playfair-display",
                    "name": "Playfair Display"
                },
                {
                    "fontFamily": "'Lora', serif",
                    "slug": "lora",
                    "name": "Lora"
                },
                {
                    "fontFamily": "'Merriweather', serif",
                    "slug": "merriweather",
                    "name": "Merriweather"
                },
                {
                    "fontFamily": "'Oswald', sans-serif",
                    "slug": "oswald",
                    "name": "Oswald"
                },
                {
                    "fontFamily": "'Bebas Neue', sans-serif",
                    "slug": "bebas-neue",
                    "name": "Bebas Neue"
                },
                {
                    "fontFamily": "'Pixelify Sans', sans-serif",
                    "slug": "pixelify-sans",
                    "name": "Pixelify Sans"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.5rem",
                    "name": "Extra Large"
                },
                {
                    "slug": "xx-large",
                    "size": "2rem",
                    "name": "2X Large"
                },
                {
                    "slug": "huge",
                    "size": "3rem",
                    "name": "Huge"
                }
            ]
        },
        "spacing": {
            "padding": true,
            "margin": true,
            "units": [
                "px",
                "em",
                "rem",
                "%",
                "vw",
                "vh"
            ],
            "spacingSizes": [
                {
                    "slug": "10",
                    "size": "0.5rem",
                    "name": "1"
                },
                {
                    "slug": "20",
                    "size": "1rem",
                    "name": "2"
                },
                {
                    "slug": "30",
                    "size": "2rem",
                    "name": "3"
                },
                {
                    "slug": "40",
                    "size": "4rem",
                    "name": "4"
                },
                {
                    "slug": "50",
                    "size": "6rem",
                    "name": "5"
                }
            ]
        },
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "custom": {
            "spacing": {
                "small": "1rem",
                "medium": "2rem",
                "large": "4rem",
                "outer": "6rem"
            },
            "typography": {
                "lineHeight": {
                    "small": 1.2,
                    "medium": 1.5,
                    "large": 1.9
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--paper)",
            "text": "var(--wp--preset--color--dark)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--blinker)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.9"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--30)"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--jersey-10)",
                    "fontSize": "clamp(3rem, 7vw, 5.25rem)",
                    "fontWeight": "400",
                    "lineHeight": "1.05"
                },
                "color": {
                    "text": "var(--wp--preset--color--purple)"
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--jersey-10)",
                    "fontSize": "clamp(2.25rem, 4.5vw, 3rem)",
                    "fontWeight": "400",
                    "lineHeight": "1.05"
                },
                "color": {
                    "text": "var(--wp--preset--color--purple)"
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--blinker)",
                    "fontSize": "clamp(1.25rem, 2.4vw, 1.5rem)",
                    "fontWeight": "900",
                    "lineHeight": "1.25"
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--blinker)",
                    "fontSize": "1.1875rem",
                    "fontWeight": "900"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--purple)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--pink)"
                    }
                }
            },
            "button": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--blinker)",
                    "fontSize": "0.9375rem",
                    "fontWeight": "900",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "lineHeight": "1"
                },
                "color": {
                    "background": "var(--wp--preset--color--yellow)",
                    "text": "var(--wp--preset--color--dark)"
                },
                "border": {
                    "radius": "0",
                    "width": "3px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--dark)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.875rem",
                        "bottom": "0.875rem",
                        "left": "1.375rem",
                        "right": "1.375rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--yellow)",
                        "text": "var(--wp--preset--color--dark)"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "0"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--blinker)",
                    "fontWeight": "900",
                    "textTransform": "uppercase"
                }
            },
            "core/heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--jersey-10)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "lineHeight": "1.9"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--30)"
                }
            },
            "core/group": {
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ],
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank",
            "postTypes": [
                "page",
                "post"
            ]
        },
        {
            "name": "full-width",
            "title": "Full Width",
            "postTypes": [
                "page"
            ]
        }
    ]
}
